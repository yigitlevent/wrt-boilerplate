{
  "name": "wrt-boilerplate",
  "author": "Yiğit Levent",
  "version": "0.0.0",
  "homepage": "http://yigitlevent.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yigitlevent/wrt-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/yigitlevent/wrt-boilerplate/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    ".tests",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"tsx .script/watch-wasm.ts\" --names \"CLN,WSM\" -c \"black.dim.bold.bgYellow,black.dim.bold.bgMagenta\"",
    "dev:tauri": "tauri dev",
    "build": "npm run build -w client",
    "build:tauri": "tauri build",
    "test": "npm test -w .tests",
    "test:watch": "npm run test:watch -w .tests",
    "test:coverage": "npm run test:coverage -w .tests",
    "lint": "eslint . --ext ts,tsx,json --report-unused-disable-directives --cache",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --fix --cache",
    "knip": "knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "25.9.9",
    "@types/react": "^19.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.7.0",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --ext ts,tsx,json --report-unused-disable-directives --cache"
  }
}
